/logs/

# Личные заметки и реквизиты серверов: в git не кладём, как и в монорепе.
/private/

# Зависимости и сборки
node_modules/
dist/
*.log
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.tsbuildinfo

# Веса моделей, чекпоинты и кеши
