# Ответы стенда установщику: чем пре-прод отличается от клиентских умолчаний.
# Файл целиком копируется в core/.env перед установкой, поэтому здесь должно
# быть всё, что есть в core/.env.example -- а не только отличия.
#
# Отличия от .env.example ровно три:
#   - порты трафика уведены с :80/:443 -- их держит хостовый nginx машины
#     (mvm.local, portainer.mvm.local);
#   - имя узла preprod-01, чтобы записи стенда не путались с рабочими;
#   - COMPOSE_PROJECT_NAME задан явно.

# --- Имя установки ---
COMPOSE_PROJECT_NAME=placitum

# --- Порты на хосте ---
PLC_HTTP_PORT=8000
PLC_HTTPS_PORT=8443
PLC_PANEL_PORT=8080

# --- Идентичность узла ---
PLC_NODE_ID=preprod-01

# --- Куки калитки и капчи ---
# Стенд отвечает по чистому HTTP: с on браузер куку не отправит.
PLC_COOKIE_SECURE=off

# --- Порты инфраструктуры ---
# На стенде смотрят в базы с хоста: порты на loopback.
PLC_INFRA_PORTS=loopback

# --- Реквизиты инфраструктуры ---
POSTGRES_USER=waf
POSTGRES_PASSWORD=waf
POSTGRES_DB=waf

CLICKHOUSE_USER=waf
CLICKHOUSE_PASSWORD=waf

MINIO_ROOT_USER=waf
MINIO_ROOT_PASSWORD=wafwafwaf

CLICKHOUSE_LOG_LEVEL=warning

# --- Сборка ---
NGINX_VERSION=1.28.0

# Отпечаток ключа контура: install.sh проставляет его сам после выпуска ключа.
# В ответах стенда он пустой -- ключ выпускается заново на каждом прогоне.
VITE_CONTOUR_FINGERPRINT=
