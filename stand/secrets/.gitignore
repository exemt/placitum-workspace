# Всё в этом каталоге — секреты окружения, в git не лежат: белый список.
#
#   contour.key / contour.pub  пара контура (node gen.mjs); приватный — только агентам
#   auth.hmac, auth-app.hmac    ключи подписи сессий калитки: openssl rand -hex 32 > auth.hmac
#   captcha.hmac                ключ подписи капчи
#   s3.creds                    реквизиты архива (WAF_RETAIN_S3_CREDENTIALS_FILE)
*
!.gitignore
!gen.mjs
